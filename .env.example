# Retention purge (optional). Set CRON_SECRET to enable the scheduled
# /api/purge endpoint; Vercel Cron sends it as a Bearer token. Without it the
# purge stays disabled. CASE_RETENTION_DAYS defaults to 30 if unset.
CRON_SECRET=
CASE_RETENTION_DAYS=30
